# Copy the INTERNAL hostname from the database service; do not use the panel URL.
DATABASE_URL=postgresql://postgresp2p:REPLACE_URL_ENCODED_PASSWORD@REPLACE_INTERNAL_HOST:5432/postgresp2p
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
NODE_ENV=production
# Copy the real public multiaddr from relay startup logs after deploying relay/.
P2P_MUSIC_RELAYS=
